root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Shell scripts and configurations often favor 2 spaces or tabs depending on style, 
# but YAML/JSON absolutely demand 2 spaces to parse correctly.
[*.{json,yaml,yml,md}]
indent_size = 2

# Ensures your IDE saves PowerShell scripts with Windows endings automatically
[*.ps1]
end_of_line = crlf
