root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

# Use 2-space indentation for structured data and markdown
[*.{json,yaml,yml,md}]
indent_size = 2

# Force Windows line endings for Windows-specific scripting languages
[*.{ps1,bat}]
end_of_line = crlf
