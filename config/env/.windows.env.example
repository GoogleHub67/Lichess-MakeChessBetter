# ==============================================================================
# LICHESS BOT ACCOUNT CONFIGURATION
# ==============================================================================
# 🌟 Generate your bot token at: https://lichess.org
# ⚠️ Ensure you check ONLY the "Play games with the bot API (bot:play)" scope.

LICHESS_TOKEN=lip_xxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# CHESS ENGINE PATH
# ==============================================================================
# Default Windows installer path. 
# 💡 If you downloaded from stockfishchess.org manually, change this to your 
# exact file location (e.g., C:\Users\YourName\Documents\stockfish.exe)
STOCKFISH_PATH=C:\Program Files\Stockfish\stockfish.exe
