# ==============================================================================
# LICHESS BOT ACCOUNT CONFIGURATION
# ==============================================================================
# 🌟 Generate your bot token at: https://lichess.org/account/oauth/token
# ⚠️ Ensure you check at least the "Play games with the bot API (bot:play)", 
# "Read incoming challenges (challenge:read)", and 
# "Send, accept, and reject challenges (challenge:write) scope.

LICHESS_TOKEN=lip_xxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# CHESS ENGINE PATH
# ==============================================================================
# Default Homebrew installation path.
# 💡 If you downloaded from stockfishchess.org manually, change this to your 
# exact file location (e.g., /Users/YourName/Downloads/stockfish)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish
