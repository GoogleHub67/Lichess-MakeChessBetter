# ==============================================================================
# LICHESS BOT ACCOUNT CONFIGURATION
# ==============================================================================
# 🌟 Generate your bot token at: https://lichess.org
# ⚠️ Ensure you check at least the "Play games with the bot API (bot:play)", 
# "Read incoming challenges (challenge:read)", and 
# "Send, accept, and reject challenges (challenge:write) scope.

LICHESS_TOKEN=lip_xxxxxxxxxxxxxxxxxxxx

# ==============================================================================
# CHESS ENGINE PATH
# ==============================================================================
# Default Linux package manager / Render Docker environment path.
# 💡 Change this if your distribution or environment uses a custom location.
STOCKFISH_PATH=/usr/games/stockfish
