# 1. Global fallback for text files
* text=auto

# 2. Strict Unix line endings (Crucial for Python, Docker, and Linux Shell script execution)
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.default text eol=lf
requirements.txt text eol=lf

# 3. Strict Windows line endings (Crucial for Windows native scripting tools)
*.ps1 text eol=crlf
*.bat text eol=crlf

# 4. Binary safety layer (Prevents Git from corrupting compiled Python bytecode)
*.pyc binary
*.pyd binary
*.pyo binary
.pytest_cache/ binary
__pycache__/ binary
